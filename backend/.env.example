PORT=5000
NODE_ENV=development

# Leave DATABASE_URL blank to run on a zero-setup local SQLite file.
# Set it to a Postgres URL (Supabase / Neon / local) to use Postgres instead —
# no code changes needed, the same models run on both.
# DATABASE_URL=postgresql://user:password@localhost:5432/acadex_erp
# DB_SSL=true

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Optional. Without it, AI notice drafting uses a built-in offline template.
# ANTHROPIC_API_KEY=
