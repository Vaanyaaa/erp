PORT=5000
NODE_ENV=development

# Works with local Postgres, Supabase, Neon, or Railway — just swap this one line.
# Local:    postgresql://postgres:devpassword@localhost:5432/edusphere_erp
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon:     postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/edusphere_erp

# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Optional — leave unset to run with push-notification logging only (no real sends)
FIREBASE_SERVICE_ACCOUNT_PATH=
